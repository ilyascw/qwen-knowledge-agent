# Telegram: bot accepts messages only from this numeric user id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Any OpenAI-compatible endpoint serving the selected Qwen model.
QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-coder-plus
QWEN_BINARY=qwen
QWEN_TIMEOUT_SECONDS=300
QWEN_REQUIRED_VERSION=0.13.1
QWEN_ENFORCE_VERSION=true

# Atlassian Cloud credentials. The MCP server is additionally started with
# --read-only and a five-tool allowlist.
JIRA_URL=https://company.atlassian.net
JIRA_USERNAME=user@company.com
JIRA_API_TOKEN=
CONFLUENCE_URL=https://company.atlassian.net/wiki
CONFLUENCE_USERNAME=user@company.com
CONFLUENCE_API_TOKEN=

# Runtime.
AGENT_PROFILE_DIR=agent
MEMORY_DB_PATH=data/memory.db
QWEN_RUNTIME_DIR=data/qwen-runtime
QWEN_WORKSPACE_DIR=data/qwen-workspace
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=12000
